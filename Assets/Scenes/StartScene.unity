  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<align=center><b><size=200%><gradient=\"FontGradient\">HOW TO PLAY</gradient></size></b>\n\n<b><size=130%><gradient=\"FontGradient\">GOAL</gradient></size></b>\nOne
    player plays a rhythm minigame while the other fights the boss.\r\nThrow orbs
    that spawn at the boss to deplete its HP while avoiding its attacks.\r\nEvery
    10 rhythm game hits spawns a new orb.\n\n<gradient=\"FontGradient\"><b>\u2500\u2500
    PLAYER 1  \xB7  RHYTHM \u2500\u2500</b></gradient>\n\nMove          <b>W A S
    D</b>\nLook          <b>F  /  H</b>\nAbility       <b>E</b>\nThrow Orb     <b>Space</b>\n\n<gradient=\"FontGradient\"><b>\u2500\u2500
    PLAYER 2  \xB7  RHYTHM \u2500\u2500</b></gradient>\n\nMove          <b>Arrow
    Keys</b>\nLook          <b>Mouse</b>\nAbility       <b>Left Click</b>\nThrow
    Orb     <b>Right Click</b>\n\n<size=80%>ESC  \xB7  Pause          9 / 0  \xB7 
    Camera FOV (P1 / P2)</size></align>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 9a54d7c4d1406ed4f815906268ac004b, type: 2}
  m_sharedMaterial: {fileID: 3996891410421939986, guid: 9a54d7c4d1406ed4f815906268ac004b, type: 2}
